DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173,https://knbn.kshimate.space

# Google Sign-In (GIS) — Client ID only is required
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional — only for OAuth redirect/code flow (not used by GIS ID-token sign-in)
GOOGLE_CLIENT_SECRET=
